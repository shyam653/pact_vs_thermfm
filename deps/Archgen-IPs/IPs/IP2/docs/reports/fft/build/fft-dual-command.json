[
  "<chipyard>/.conda-env/riscv-tools/bin/riscv64-unknown-elf-gcc",
  "-O2",
  "-Wall",
  "-Wextra",
  "-Werror",
  "-march=rv64imac_zicsr_zifencei",
  "-mabi=lp64",
  "-mcmodel=medany",
  "-nostdlib",
  "-nostartfiles",
  "-static",
  "-fno-builtin",
  "-fno-common",
  "-fno-stack-protector",
  "-Wl,--no-relax",
  "-T",
  "<ip2>/tests/link.ld",
  "-I",
  "<test-build>",
  "-DFFT_HARTS=2",
  "-DFFT_NEGATIVE_CONTROL=0",
  "<ip2>/tests/start.S",
  "<ip2>/tests/fft_test.c",
  "-o",
  "<test-build>/fft-dual.riscv"
]
