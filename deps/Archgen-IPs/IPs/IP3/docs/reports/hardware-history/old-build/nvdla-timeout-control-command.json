[
  "${CHIPYARD_ROOT}/.conda-env/riscv-tools/bin/riscv64-unknown-elf-gcc",
  "-O2",
  "-Wall",
  "-Wextra",
  "-Werror",
  "-march=rv64imac_zicsr_zifencei",
  "-mabi=lp64",
  "-mcmodel=medany",
  "-nostdlib",
  "-nostartfiles",
  "-static",
  "-fno-builtin",
  "-fno-common",
  "-fno-stack-protector",
  "-Wl,--no-relax",
  "-T",
  "${REPO_ROOT}/IPs/IP3/tests/link.ld",
  "-DNVDLA_IRQ=1",
  "-DNVDLA_SKIP_ENABLE=1",
  "-DNVDLA_POLL_LIMIT=4096",
  "${REPO_ROOT}/IPs/IP3/tests/start.S",
  "${REPO_ROOT}/IPs/IP3/tests/nvdla_test.c",
  "-o",
  "${ORIGINAL_TEST_BUILD}/nvdla-timeout-control.riscv"
]
