[
  "<chipyard>/.conda-env/riscv-tools/bin/riscv64-unknown-elf-gcc",
  "-O2",
  "-Wall",
  "-Wextra",
  "-Werror",
  "-march=rv64imac_zicsr_zifencei",
  "-mabi=lp64",
  "-mcmodel=medany",
  "-nostdlib",
  "-nostartfiles",
  "-static",
  "-fno-builtin",
  "-fno-common",
  "-fno-stack-protector",
  "-Wl,--no-relax",
  "-T",
  "<ip3>/tests/link.ld",
  "-DNVDLA_IRQ=1",
  "-DNVDLA_SKIP_ENABLE=1",
  "-DNVDLA_POLL_LIMIT=4096",
  "<ip3>/tests/start.S",
  "<ip3>/tests/nvdla_test.c",
  "-o",
  "<test-build>/nvdla-timeout-control.riscv"
]
